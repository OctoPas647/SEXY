<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is allowed because your server is reached over Tailscale (already WireGuard-encrypted)
     or your own LAN. GitHub always uses https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
